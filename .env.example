# Supabase (Free tier — DB 500 MB · Storage 1 GB · Egress 5 GB)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — used by /api/admin after login (never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Canonical site URL (no trailing slash) — used for sitemap, canonicals, schema
NEXT_PUBLIC_SITE_URL=https://hcep.in

# Vercel Cron keep-alive (prevents free-tier pause after 7 idle days)
CRON_SECRET=replace-with-a-long-random-string
